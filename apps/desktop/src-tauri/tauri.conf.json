{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openlocus",
  "version": "0.1.0",
  "identifier": "com.openlocus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenLocus",
        "label": "main",
        "visible": false,
        "width": 1200,
        "height": 800
      },
      {
        "title": "OpenLocus",
        "label": "splashscreen",
        "url": "/splash",
        "width": 400,
        "height": 300,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
